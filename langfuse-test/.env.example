# Langfuse（必填）— 在 https://cloud.langfuse.com 或自建实例创建
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# OpenAI 兼容 API（必填）
OPENAI_API_KEY=
# 可选：自定义兼容端点（如 Azure / 国内网关 / 本地代理）
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型名称
OPENAI_MODEL=qwen-plus

# LangChain 的回调派发开关（不是 Langfuse 变量，由 @langchain/core 的 CallbackManager 读取）：
#   true （LangChain 默认）：回调后台异步派发，await invoke() 返回时不保证 CallbackHandler 已写完
#   false（本项目）        ：invoke 返回前 await 完所有回调 handler，返回即 trace 数据就绪
# 短生命周期脚本（index.mjs / evaluate.mjs）必须为 false：否则脚本收尾 forceFlush + shutdown 时，
# 后台回调可能还没把 span 送出，Langfuse 里会丢 trace 或只剩前半截。
# 该变量只影响 LangChain 回调通道，OTEL 通道（LangfuseSpanProcessor）不受它控制，靠 forceFlush() 收尾。
LANGCHAIN_CALLBACKS_BACKGROUND=false

# 评测 Dataset 名称（可选，默认 deepagents-eval）
# LANGFUSE_DATASET_NAME=deepagents-eval
