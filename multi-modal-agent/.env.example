# ── 通义千问 / 万相（DashScope）──────────────────────────────
# DashScope 的 API Key，所有理解类与生成类脚本共用这一个 Key
OPENAI_API_KEY=sk-xx
# 兼容模式地址（理解类脚本用 ChatOpenAI 时走这里）
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── 阿里云 OSS（仅 src/sts-gen.mjs 直传签名需要）───────────────
# 主账号或子账号的 AK/SK，用于生成前端直传凭证
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
