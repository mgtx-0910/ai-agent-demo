# cp .env.example .env 后填写

# ============ LLM（OpenAI 兼容接口）============
# 大模型 API Key
OPENAI_API_KEY=sk-xxxxx
# 自定义 API 端点（阿里百炼 / DeepSeek 等）
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 对话模型名称（mem0-redis-mem0-agent.mjs 等本目录脚本读取 OPENAI_MODEL）
OPENAI_MODEL=qwen-plus

# ============ LangSmith 链路追踪（可选）============
# 用于身份验证，实现链路上报
LANGCHAIN_API_KEY=lsv2_xx
# 指定 LangSmith 中的项目，追踪结果会归类到该项目下
LANGCHAIN_PROJECT=mem0-test
# 开启 LangSmith 追踪功能
LANGCHAIN_TRACING_V2=true

# ============ Redis（默认与 docker-compose 一致）============
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# 短期记忆：key 前缀、会话 ID、过期时间（秒）
MEMORY_KEY_PREFIX=agent:short_memory
MEMORY_SESSION_ID=session_001
MEMORY_TTL_SECONDS=1800

# 启动时清空会话记忆（默认保留，方便多次运行续聊）
# CLEAR_MEMORY=1

# ============ Mem0（平台: https://platform.mem0.ai）============
# Mem0 云端 API Key
MEM0_API_KEY=m0-xxxxx
# 用户层标识：换新会话仍应记住该用户的长期事实（注意是 MEM0_USER_ID，不是 MEM0USER_ID）
MEM0_USER_ID=demo_user_001
# 语义检索返回条数
MEM0_TOP_K=5
# 本地部署版 mem0 服务鉴权 Key（仅 mem0-local-api-demo.mjs 需要；服务端未开鉴权可留空）
MEM0_LOCAL_API_KEY=
# 关闭 SDK 内置遥测上报：无法直连 PostHog 时会反复打印 ECONNREFUSED 噪音（false 关闭）
MEM0_TELEMETRY=false
