{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug cron-job-tool",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "start:debug"],
            "cwd": "${workspaceFolder}/cron-job-tool",
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"],
            "port": 9229,
            "sourceMaps": true,
            "resolveSourceMapLocations": [
                "${workspaceFolder}/**",
                "!**/node_modules/**"
            ],
            "autoAttachChildProcesses": true
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debug hello-nest-langchain",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "start:debug"],
            "cwd": "${workspaceFolder}/hello-nest-langchain",
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"],
            "port": 9229,
            "sourceMaps": true,
            "resolveSourceMapLocations": [
                "${workspaceFolder}/**",
                "!**/node_modules/**"
            ],
            "autoAttachChildProcesses": true
        }
    ]
}
