# cp .env.example .env 后填写

# OpenAI 兼容 API 密钥
OPENAI_API_KEY=sk-xxxxx

# 自定义 API 端点（阿里百炼 / DeepSeek 等）
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 聊天模型名称（hello-langchain/tool-file-read/mini-cursor 用 qwen-coder-turbo）
# mcp-test/langchain-mcp-test 用 qwen-plus
MODEL_NAME=qwen-coder-turbo

# 高德地图 API 密钥（仅 mcp-test.mjs）
AMAP_MAPS_API_KEY=your_amap_key

# 文件系统 MCP 路径（仅 mcp-test.mjs）
ALLOWED_PATHS=C:\path\to\your\mcp-server.mjs
