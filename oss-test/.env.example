# ============================================================
# oss-test 环境变量模板
# 用法：复制本文件为 .env，再填入你自己的值（dotenv 会从当前目录读取 .env）
# 三个脚本各读自己的一组变量，用不到的可以留空
# ============================================================

# ---- 阿里云 OSS（给 oss-upload.mjs 用）----
OSS_REGION=oss-cn-beijing                       # Bucket 所在地域，如 oss-cn-hangzhou
OSS_ACCESS_KEY_ID=LTAI5tABJ6BXekZDhfHSTCBN      # 阿里云 AccessKey ID（RAM 用户）
OSS_ACCESS_KEY_SECRET=                           # 阿里云 AccessKey Secret
OSS_BUCKET=agent-bucket123                       # Bucket 名称，需提前在控制台创建

# ---- 本地 MinIO / RustFS（给 minio-upload.mjs 用，需 docker-compose 起服务）----
MINIO_ACCESS_KEY=                                # 与 docker-compose 的 RUSTFS_ACCESS_KEY 对应，默认 admin
MINIO_SECRET_KEY=                                # 与 docker-compose 的 RUSTFS_SECRET_KEY 对应，默认 Admin@123456

# ---- 通用 S3 协议（给 s3-upload.mjs 用）----
# 注意：9000/9001 落在 Windows 保留段(8947-9046)绑不了；19000/19001 又被已有 minio-dev 容器占用，
#       docker-compose 故把宿主映射改到 29000/29001
S3_ENDPOINT=http://localhost:29000                   # 本地私有存储需含协议+端口
S3_PORT=29000                                        # 参考端口（脚本未直接使用，端口需拼进 S3_ENDPOINT）
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=Admin@123456
